# Docker Compose Postgres (docker compose up -d)
DATABASE_URL=postgresql+psycopg://formcast:formcast@localhost:5433/formcast
TEST_DATABASE_URL=postgresql+psycopg://formcast:formcast@localhost:5433/formcast_test

# Seconds to wait between per-player FPL requests (~700 players per run).
FPL_REQUEST_DELAY=0.1

# Scheduler: how often to refresh, and how soon to retry after a failure.
REFRESH_INTERVAL_HOURS=24
REFRESH_RETRY_MINUTES=30
